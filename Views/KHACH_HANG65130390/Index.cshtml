@model IEnumerable<QLMYCF_65130390.Models.KHACH_HANG>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Khách hàng";
    int i = 0;
}

<h2 class="page-title">📋 DANH SÁCH KHÁCH HÀNG</h2>

<table class="table-custom">
    <tr>
        <th>STT</th>
        <th>Họ tên</th>
        <th>Email</th>
        <th>SĐT</th>
        <th>Địa chỉ</th>
        <th>Chức năng</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@(++i)</td>
            <td>@item.HoTen</td>
            <td>@item.Email</td>
            <td>@item.SoDienThoai</td>
            <td>@item.DiaChi</td>
            <td>
                <a href="@Url.Action("Edit", new { id = item.MaKH })" class="btn-action btn-edit">
                    <img src="~/Images/edit.jpg" style="width:20px;height:20px;" />
                </a>

                <a href="@Url.Action("Details", new { id = item.MaKH })" class="btn-action btn-info2">
                    <img src="~/Images/details.jpg" style="width:20px;height:20px;" />
                </a>

                <a href="@Url.Action("Delete", new { id = item.MaKH })"
                   onclick="return confirm('Xóa khách hàng này?');"
                   class="btn-action btn-delete">
                    <img src="~/Images/delete.jpg" style="width:20px;height:20px;" />
                </a>
            </td>

        </tr>
    }
</table>

<style>
    .page-title {
        color: #8B5E34;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .table-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 5px;
    }

        .table-custom th {
            background-color: #8B5E34;
            color: white;
            padding: 12px;
            text-align: center;
            font-weight: 600;
            border-radius: 6px 6px 0 0;
        }

        .table-custom td {
            background: #fff;
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
        }

        .table-custom tr:hover td {
            background-color: #f5f2ef;
            transition: .25s;
        }

    .btn-action {
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        margin-right: 5px;
        color: white !important;
        transition: 0.25s;
    }

    .btn-edit {
        background-color: #f0ad4e;
    }

        .btn-edit:hover {
            background-color: #ec9a35;
        }

    .btn-info2 {
        background-color: #0275d8;
    }

        .btn-info2:hover {
            background-color: #025aa5;
        }

    .btn-delete {
        background-color: #d9534f;
    }

        .btn-delete:hover {
            background-color: #c9302c;
        }
</style>
