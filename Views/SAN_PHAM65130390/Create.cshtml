@model QLMYCF_65130390.Models.SAN_PHAM
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Thêm sản phẩm";
}

<h3 class="page-title">➕ THÊM SẢN PHẨM</h3>

<div class="form-box">
    @using (Html.BeginForm("Create", "SAN_PHAM65130390", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="mb-3">
            <label>Mã sản phẩm</label>
            @Html.TextBoxFor(m => m.MaSP, new { @class = "form-control input-brown", required = "required" })
        </div>

        <div class="mb-3">
            <label>Tên sản phẩm</label>
            @Html.TextBoxFor(m => m.TenSP, new { @class = "form-control input-brown", required = "required" })
        </div>

        <div class="mb-3">
            <label>Mô tả</label>
            @Html.TextBoxFor(m => m.MoTaSP, new { @class = "form-control input-brown" })
        </div>

        <div class="mb-3">
            <label>Giá</label>
            @Html.TextBoxFor(m => m.DonGia, new { @class = "form-control input-brown", required = "required" })
        </div>

        <div class="mb-3">
            <label>Đơn vị tính</label>
            @Html.TextBoxFor(m => m.DonViTinh, new { @class = "form-control input-brown", required = "required" })
        </div>

        <div class="mb-3">
            <label>Loại sản phẩm</label>
            @Html.DropDownList("MaLSP", null, new { @class = "form-control input-brown" })
        </div>

        <div class="mb-3">
            <label>Ảnh sản phẩm</label>
            <input type="file" name="AnhSanPham" class="form-control input-brown" />
        </div>

        <button class="btn btn-add mt-2">Lưu</button>
    }
</div>

<a href="@Url.Action("Index")" class="btn btn-back mt-3">⬅ Quay lại</a>

<style>
    .page-title {
        color: #8B5E34;
        font-weight: 700;
        margin-bottom: 20px;
        border-left: 6px solid #8B5E34;
        padding-left: 10px;
    }

    .form-box {
        background: #fff;
        padding: 25px 30px;
        border-radius: 12px;
        border-left: 6px solid #8B5E34;
        width: 70%;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .input-brown {
        border-radius: 8px;
        padding: 10px;
        border: 1px solid #bfa58a;
        margin-bottom: 12px;
        transition: .25s;
    }

        .input-brown:focus {
            border-color: #8B5E34;
            box-shadow: 0 0 6px rgba(139, 94, 52, 0.4);
        }

    .btn-add {
        background-color: #8B5E34;
        padding: 10px 22px;
        border-radius: 8px;
        color: white;
        font-weight: 600;
        border: none;
        transition: .25s;
        box-shadow: 0 3px 6px rgba(0,0,0,0.25);
    }

        .btn-add:hover {
            background-color: #704A29;
            transform: translateY(-2px);
        }

    .btn-back {
        background-color: #8B5E34;
        color: white;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.25s;
        box-shadow: 0 3px 6px rgba(0,0,0,0.25);
    }

        .btn-back:hover {
            background-color: #704A29;
            transform: translateY(-2px);
        }
</style>
