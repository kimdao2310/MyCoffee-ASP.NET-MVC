
@model QLMYCF_65130390.Models.GIO_HANG
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="title">📄 Chi tiết đơn hàng #@Model.MaHD</h2>

<div class="box shadow-sm">
    <h4 class="section">Thông tin đơn hàng</h4>

    <p><strong>Ngày đặt:</strong> @Model.NgayDatHang.ToString("dd/MM/yyyy")</p>
    <p><strong>Tổng tiền:</strong> @String.Format("{0:N0} đ", Model.TongTien)</p>

    <h4 class="section">Sản phẩm</h4>

    <table class="table table-bordered">
        <tr>
            <th>Sản phẩm</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
        </tr>

        @foreach (var ct in Model.CHI_TIET_GH)
        {
            <tr>
                <td>@ct.SAN_PHAM.TenSP</td>
                <td>@String.Format("{0:N0} đ", ct.DonGia)</td>
                <td>@ct.SoLuong</td>
                <td>@String.Format("{0:N0} đ", ct.SoLuong * ct.DonGia)</td>
            </tr>
        }
    </table>

    <a href="@Url.Action("About", "Home")" class="btn btn-brown mt-3">⬅ Quay lại</a>
</div>

<style>
    .title {
        color: #8B5E34;
        font-weight: bold;
    }

    .box {
        background: #fff;
        padding: 20px;
        border-radius: 10px;
    }

    .section {
        color: #8B5E34;
        margin-top: 15px;
        font-weight: 600;
    }

    .btn-brown {
        background: #8B5E34;
        color: white;
        padding: 8px 20px;
        border-radius: 6px;
    }

        .btn-brown:hover {
            background: #704A29;
        }
</style>


