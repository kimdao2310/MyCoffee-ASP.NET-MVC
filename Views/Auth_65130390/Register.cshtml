@model QLMYCF_65130390.Models.KHACH_HANG
@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="register-container">
    <div class="register-box">

        <h3 class="text-center mb-4">Đăng ký tài khoản</h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm())
        {
            <div class="mb-3">
                <label>Họ và tên</label>
                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", required = "required" })
            </div>

            <div class="mb-3">
                <label>Số điện thoại</label>
                @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                <label>Email</label>
                @Html.TextBoxFor(m => m.Email, new { type = "email", @class = "form-control", required = "required" })
            </div>

            <div class="mb-3">
                <label>Mật khẩu</label>
                @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", required = "required" })
            </div>

            <div class="mb-3">
                <label>Địa chỉ</label>
                @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control" })
            </div>

            <button class="btn btn-dark w-100">Đăng ký</button>

            <p class="text-center mt-3">
                Bạn đã có tài khoản?
                <a href="@Url.Action("Login", "Auth_65130390")">Đăng nhập</a>
            </p>
        }
    </div>
</div>


<style>
/* NỀN TRANG */
.register-container {
    display: flex;
    justify-content: center;
    margin-top: 40px;
    padding: 20px;
}

/* HỘP ĐĂNG KÝ */
.register-box {
    width: 500px;
    background: #ffffff;
    padding: 30px 35px;
    border-radius: 12px;
    border: 1px solid #e6e0d8;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    animation: fadeIn 0.4s ease-in-out;
}

/* TIÊU ĐỀ */
.register-box h3 {
    font-weight: 700;
    color: #8B5E34;
}

/* INPUT */
.register-box .form-control {
    height: 45px;
    border-radius: 8px;
    border: 1px solid #d4c6bc;
}

.register-box .form-control:focus {
    border-color: #8B5E34;
    box-shadow: 0 0 6px rgba(139,94,52,0.4);
}

/* BUTTON */
.register-box button {
    background: #8B5E34 !important;
    border: none;
    height: 45px;
    font-size: 18px;
    border-radius: 8px;
    transition: 0.25s;
}

.register-box button:hover {
    background: #704A29 !important;
    transform: translateY(-2px);
}

/* LINK */
.register-box a {
    color: #8B5E34;
    font-weight: bold;
    text-decoration: none;
}

.register-box a:hover {
    text-decoration: underline;
}


</style>
