@model IEnumerable<QLMYCF_65130390.Models.NHAN_VIEN>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Nhân viên";
    int i = 0;
}

<h2 class="mb-3">👥 DANH SÁCH NHÂN VIÊN</h2>

<p>
    @Html.ActionLink("➕ Thêm nhân viên", "Create", null, new { @class = "btn-add-brown" })
</p>

<table class="table-custom">
    <tr>
        <th>STT</th>
        <th>Họ tên</th>
        <th>Email</th>
        <th>SĐT</th>
        <th>Chức vụ</th>
        <th>Ngày vào làm</th>
        <th>Chức năng</th>
    </tr>

    @foreach (var nv in Model)
    {
        <tr>
            <td>@(++i)</td>
            <td>@nv.HoTenNV</td>
            <td>@nv.Email</td>
            <td>@nv.SoDienThoai</td>
            <td>@nv.Quyen</td>
            <td>@(nv.NgayVaoLam?.ToString("dd/MM/yyyy"))</td>

            <td>
                <a href="@Url.Action("Edit", new { id = nv.MaNV })" class="btn-action btn-edit">
                    <img src="~/Images/edit.jpg" class="icon-btn" />
                </a>

                <a href="@Url.Action("Details", new { id = nv.MaNV })" class="btn-action btn-info2">
                    <img src="~/Images/details.jpg" class="icon-btn" />
                </a>

                <a href="@Url.Action("Delete", new { id = nv.MaNV })"
                   onclick="return confirm('Xóa nhân viên này?');"
                   class="btn-action btn-delete">
                    <img src="~/Images/delete.jpg" class="icon-btn" />
                </a>
            </td>
        </tr>
    }
</table>

<style>
    /* ------------------ BUTTON THÊM MỚI ------------------ */
    .btn-add-brown {
        background: linear-gradient(135deg, #8B5E34, #A67645);
        color: white !important;
        border: none;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 600;
        box-shadow: 0 3px 6px rgba(0,0,0,0.25);
        transition: 0.25s;
        text-decoration: none;
    }

        .btn-add-brown:hover {
            background: linear-gradient(135deg, #704A29, #8B5E34);
            transform: translateY(-2px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.35);
        }

    /* ------------------ TABLE STYLE ------------------ */
    .table-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 6px;
        font-family: Arial;
    }

        .table-custom th {
            background: #8B5E34;
            color: #fff;
            padding: 12px;
            border-radius: 6px 6px 0 0;
        }

        .table-custom td {
            background: #fff;
            padding: 12px;
            border-bottom: 1px solid #e0e0e0;
            text-align: center;
        }

        .table-custom tr:hover td {
            background: #f5f2ef;
            transition: 0.2s;
            transform: translateY(-2px);
        }

    /* ------------------ ICON ------------------ */
    .icon-btn {
        width: 22px;
        height: 22px;
        transition: 0.2s;
        cursor: pointer;
    }

        .icon-btn:hover {
            transform: scale(1.25);
        }

    /* Align icons */
    .btn-action {
        margin: 0 3px;
        display: inline-block;
    }
</style>
