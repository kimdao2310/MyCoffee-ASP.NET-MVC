@using QLMYCF_65130390.Models
@{
    KHACH_HANG kh = Session["KH"] as KHACH_HANG;
    var adminName = Session["TenNguoiDung"];
    var adminRole = Session["Quyen"];
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - QL Coffee</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        .navbar-brand {
            font-weight: bold;
            font-size: 1.6rem;
            color: #fff !important;
            text-shadow: 0 1px 2px rgba(0,0,0,0.3);
        }


        /* NAVBAR BACKGROUND – đổi đen sang nâu đẹp */
        .navbar {
            background: #8B5E34 !important;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        }

        /* LINK */
        .nav-link {
            font-size: 1rem;
            margin-right: 15px;
            color: #fff !important;
            font-weight: 500;
            transition: 0.25s;
        }

            .nav-link:hover {
                color: #FFE5C2 !important; /* nâu sáng nhạt */
                transform: translateY(-1px);
            }

        /* SEARCH INPUT */
        .form-control {
            border-radius: 8px;
            border: 1px solid #c9b29a;
        }

            .form-control:focus {
                border-color: #704A29;
                box-shadow: 0 0 5px rgba(112,74,41,0.4);
            }

        /* LOGIN BUTTON */
        .btn-outline-light {
            border-color: #fff;
            color: #fff;
        }

            .btn-outline-light:hover {
                background: #704A29;
                color: #fff;
            }

        /* ĐĂNG KÝ -> đổi sang nâu đẹp */
        .btn-warning {
            background: #FFE5C2 !important;
            color: #8B5E34 !important;
            border: 1px solid #c9b29a;
        }

            .btn-warning:hover {
                background: #e6c7a1 !important;
                color: #704A29 !important;
            }

        /* DROPDOWN */
        .dropdown-menu {
            border-radius: 10px;
            border: 1px solid #e3d5c7;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        .dropdown-item:hover {
            background: #FFE5C2;
            color: #704A29 !important;
            border-radius: 6px;
        }

        /* FOOTER */
        .footer {
            background: #704A29;
            color: #f3e8dd;
            padding: 35px 0;
            margin-top: 40px;
        }

            .footer a {
                color: #FFE5C2;
            }

                .footer a:hover {
                    color: #fff;
                }
    </style>

</head>

<body>

    <!-- HEADER MENU -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">

            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                ☕ MY COFFEE
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="navbarNav" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("About", "Home")">Sản phẩm</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Contact", "Home")">Tin tức</a>
                    </li>
                </ul>

                <!-- SEARCH -->
                <form class="d-flex me-3" method="get" action="@Url.Action("Search","Home")">
                    <input class="form-control" name="keyword" type="search" placeholder="Tìm sản phẩm..." />
                </form>

                <!-- LOGIN / LOGOUT -->
                @* Trường hợp: CHƯA ĐĂNG NHẬP *@
                @if (kh == null && (adminRole == null || adminRole.ToString() == "Khách hàng"))
                {
                    <a href="@Url.Action("Login", "Auth_65130390")" class="btn btn-outline-light me-2">Đăng nhập</a>
                    <a href="@Url.Action("Register", "Auth_65130390")" class="btn btn-warning text-dark">Đăng ký</a>
                }
                @* Trường hợp: ADMIN / NHÂN VIÊN đăng nhập *@
                else if (adminRole != null && adminRole.ToString() != "Khách hàng")
                {
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">
                            👑 @adminName (Admin)
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Admin_65130390")">Trang quản trị</a></li>
                            <li><hr /></li>
                            <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Auth_65130390")">Đăng xuất</a></li>
                        </ul>
                    </div>
                }
                @* Trường hợp: KHÁCH HÀNG đăng nhập *@
                else
                {
                    <div class="dropdown">
                        <button class="btn btn-warning dropdown-toggle" data-bs-toggle="dropdown">
                            Xin chào, @kh.HoTen
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="@Url.Action("LichSuDonHang", "Home")">Lịch sử đơn hàng</a></li>
                            <li><hr /></li>
                            <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Auth_65130390")">Đăng xuất</a></li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </nav>

    @RenderSection("BannerQC", required: false)

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="footer text-center">
        <div class="container">
            <p>© 2025 MY COFFEE – Website </p>
            <p>
                <a href="@Url.Action("Contact","Home")">Tin tức</a> |
                <a href="@Url.Action("LienHe","Home")">Liên hệ</a>
            </p>
        </div>
    </footer>

</body>
</html>
