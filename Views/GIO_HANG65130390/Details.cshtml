@model QLMYCF_65130390.Models.GIO_HANG

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Chi tiết đơn hàng";
}

<h2 class="page-title">📄 CHI TIẾT ĐƠN HÀNG #@Model.MaHD</h2>

<div class="detail-box">
    <h4 class="section-title">Thông tin đơn hàng</h4>

    <div class="info-grid">
        <div><strong>Ngày đặt:</strong> @Model.NgayDatHang.ToString("dd/MM/yyyy")</div>

        <!-- ⭐ SỬA DÒNG NÀY ⭐ -->
        <div>
            <strong>Tổng tiền:</strong>
            @String.Format("{0:0,0} đ", Model.CHI_TIET_GH.Sum(x => x.SoLuong * x.DonGia))
        </div>

        <div><strong>Trạng thái:</strong> @GetStatus(Model.TrangThai)</div>
        
    </div>

    <hr />

    <h4 class="section-title">Thông tin khách hàng</h4>

    <div class="info-grid">
        <div><strong>Họ tên:</strong> @Model.KHACH_HANG.HoTen</div>
        <div><strong>SĐT:</strong> @Model.KHACH_HANG.SoDienThoai</div>
        <div><strong>Email:</strong> @Model.KHACH_HANG.Email</div>
        <div><strong>Địa chỉ:</strong> @Model.KHACH_HANG.DiaChi</div>
    </div>

    <hr />

    <h4 class="section-title">Nhân viên xử lý</h4>

    <div class="info-grid">
        <div><strong>Người đặt:</strong> @(Model.NHAN_VIEN != null ? Model.NHAN_VIEN.HoTenNV : "Không có")</div>

        <div><strong>Người duyệt:</strong> @(Model.NHAN_VIEN1 != null ? Model.NHAN_VIEN1.HoTenNV : "Chưa duyệt")</div>

        <div><strong>Người giao:</strong> @(Model.NHAN_VIEN2 != null ? Model.NHAN_VIEN2.HoTenNV : "Chưa giao")</div>

    </div>

    <hr />

    <h4 class="section-title">Chi tiết sản phẩm</h4>

    <table class="table-custom">
        <tr>
            <th>Sản phẩm</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
        </tr>

        @foreach (var ct in Model.CHI_TIET_GH)
        {
            <tr>
                <td>@ct.SAN_PHAM.TenSP</td>
                <td>@String.Format("{0:0,0} đ", ct.DonGia)</td>
                <td>@ct.SoLuong</td>
                <td>@String.Format("{0:0,0} đ", ct.SoLuong * ct.DonGia)</td>
            </tr>
        }
    </table>

    <div class="total-box">
        <strong>Tổng thanh toán:</strong>

        <!-- ⭐ SỬA DÒNG NÀY ⭐ -->
        @String.Format("{0:0,0} đ", Model.CHI_TIET_GH.Sum(x => x.SoLuong * x.DonGia))
    </div>

    <a href="@Url.Action("Index")" class="btn-back mt-3">⬅ Quay lại</a>
</div>


@helper GetStatus(int s)
{
    string text = "";
    string color = "";

    switch (s)
    {
        case 0: text = "Chờ duyệt"; color = "#d9534f"; break;
        case 1: text = "Đã duyệt"; color = "#0275d8"; break;
        case 2: text = "Đang giao"; color = "#f0ad4e"; break;
        case 3: text = "Hoàn tất"; color = "#5cb85c"; break;
    }

    <span style="padding: 5px 12px; background:@color; color:white; border-radius:6px; font-weight:bold;">
        @text
    </span>
}

<style>
    .page-title {
        color: #8B5E34;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .detail-box {
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        border-left: 6px solid #8B5E34;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .section-title {
        color: #8B5E34;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        row-gap: 8px;
        margin-bottom: 10px;
    }

    /* Table chi tiết sản phẩm */
    .table-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 6px;
        margin-top: 10px;
    }

        .table-custom th {
            background: #8B5E34;
            color: white;
            padding: 10px;
            border-radius: 6px 6px 0 0;
            text-align: center;
        }

        .table-custom td {
            background: #fff;
            padding: 10px;
            border-bottom: 1px solid #e0e0e0;
            text-align: center;
        }

        .table-custom tr:hover td {
            background: #f5f2ef;
            transform: translateY(-2px);
            transition: 0.2s;
        }

    /* Tổng tiền */
    .total-box {
        background: #F9F2EC;
        padding: 15px;
        border-radius: 8px;
        text-align: right;
        font-size: 1.2rem;
        font-weight: bold;
        color: #8B5E34;
        margin-top: 15px;
    }

    /* Nút quay lại */
    .btn-back {
        background-color: #8B5E34;
        color: white;
        padding: 8px 20px;
        border-radius: 8px;
        display: inline-block;
        margin-top: 15px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.25s;
    }

        .btn-back:hover {
            background-color: #704A29;
            transform: translateY(-2px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.3);
        }
</style>
