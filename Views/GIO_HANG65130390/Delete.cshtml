@model QLMYCF_65130390.Models.GIO_HANG

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Xóa đơn hàng";
}

<h2 class="page-title">⚠️ XÁC NHẬN XÓA ĐƠN HÀNG</h2>

<div class="delete-box">

    <p class="warning-text">
        Bạn có chắc chắn muốn xóa đơn hàng <strong>#@Model.MaHD</strong>?
        <br />
        Hành động này <strong>không thể hoàn tác</strong>.
    </p>

    <div class="info-grid">
        <div><strong>Khách hàng:</strong> @Model.KHACH_HANG.HoTen</div>
        <div><strong>Ngày đặt:</strong> @Model.NgayDatHang.ToString("dd/MM/yyyy")</div>
        <div><strong>Tổng tiền:</strong> @String.Format("{0:0,0} đ", Model.TongTien)</div>
        <div><strong>Trạng thái:</strong> @GetStatus(Model.TrangThai)</div>
    </div>

    <hr />

    @using (Html.BeginForm())
    {
        <button type="submit" class="btn-delete">🗑 Xóa đơn</button>
        <a href="@Url.Action("Index")" class="btn-back">⬅ Quay lại</a>
    }
</div>

@helper GetStatus(int s)
{
    string text = "";
    string color = "";

    switch (s)
    {
        case 0: text = "Chờ duyệt"; color = "#d9534f"; break;
        case 1: text = "Đã duyệt"; color = "#0275d8"; break;
        case 2: text = "Đang giao"; color = "#f0ad4e"; break;
        case 3: text = "Hoàn tất"; color = "#5cb85c"; break;
    }

    <span style="padding: 5px 12px; background:@color; color:white; border-radius:6px; font-weight:bold;">
        @text
    </span>
}

<style>
    .page-title {
        color: #8B5E34;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .delete-box {
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        border-left: 6px solid #c0392b;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 65%;
    }

    .warning-text {
        background: #fff3f3;
        border-left: 4px solid #e74c3c;
        padding: 12px;
        border-radius: 8px;
        color: #c0392b;
        font-size: 1rem;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        row-gap: 8px;
        margin-bottom: 10px;
    }

    .btn-delete {
        background: #e74c3c;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        transition: 0.25s;
        margin-right: 10px;
        box-shadow: 0 3px 6px rgba(0,0,0,0.25);
    }

        .btn-delete:hover {
            background: #c0392b;
            transform: translateY(-2px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.35);
        }

    .btn-back {
        background-color: #8B5E34;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.25s;
    }

        .btn-back:hover {
            background-color: #704A29;
            transform: translateY(-2px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.35);
        }
</style>
