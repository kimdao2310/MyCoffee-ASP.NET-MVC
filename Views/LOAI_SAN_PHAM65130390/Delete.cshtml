@model QLMYCF_65130390.Models.LOAI_SAN_PHAM

@{
    ViewBag.Title = "Xóa loại sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-danger text-white text-center py-3">
            <h3 class="m-0">Xóa loại sản phẩm</h3>
        </div>

        <div class="card-body">

            <p class="text-center text-muted">Bạn có chắc chắn muốn xóa mục này?</p>

            <hr />

            <dl class="row">
                <dt class="col-sm-4 fw-bold">Tên loại:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.TenLSP)</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-danger px-4 py-2">
                        <i class="bi bi-trash"></i> Xóa
                    </button>

                    <a href="@Url.Action("Index")" class="btn btn-secondary px-4 py-2 ms-2">
                        Quay lại
                    </a>
                </div>
            }
        </div>
    </div>
</div>
