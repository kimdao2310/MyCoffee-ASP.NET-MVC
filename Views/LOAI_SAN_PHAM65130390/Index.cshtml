@model IEnumerable<QLMYCF_65130390.Models.LOAI_SAN_PHAM>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Loại sản phẩm";
    int i = 0;
}

<h2 class="page-title">📑 DANH SÁCH LOẠI SẢN PHẨM</h2>

<p>
    @Html.ActionLink("➕ Thêm loại sản phẩm", "Create", null, new { @class = "btn-add-brown" })
</p>

<table class="table-custom">
    <tr>
        <th>STT</th>
        <th>Mã loại</th>
        <th>Tên loại sản phẩm</th>
        <th>Chức năng</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@(++i)</td>
            <td>@item.MaLSP</td>
            <td>@item.TenLSP</td>

            <td>
                <a href="@Url.Action("Edit", new { id = item.MaLSP })" class="btn-action btn-edit">
                    <img src="~/Images/edit.jpg" style="width:20px;height:20px;" /></a>
                <a href="@Url.Action("Details", new { id = item.MaLSP })" class="btn-action btn-info2">
                   
                    <img src="~/Images/details.jpg" style="width:20px;height:20px;" />
                </a>
                <a href="@Url.Action("Delete", new { id = item.MaLSP })"
                   onclick="return confirm('Bạn có chắc muốn xóa?');"
                   class="btn-action btn-delete">
                    
                    <img src="~/Images/delete.jpg" style="width:20px;height:20px;" />
                </a>
            </td>
        </tr>
    }
</table>

<style>
    .page-title {
        color: #8B5E34;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .btn-add-brown {
        background: linear-gradient(135deg, #8B5E34, #A67645);
        color: white !important;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 3px 6px rgba(0,0,0,0.25);
        transition: 0.25s ease;
    }

        .btn-add-brown:hover {
            background: linear-gradient(135deg, #704A29, #8B5E34);
            transform: translateY(-2px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.35);
        }

    /* Bảng */
    .table-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 5px;
    }

        .table-custom th {
            background-color: #8B5E34;
            color: white;
            padding: 12px;
            text-align: center;
            font-weight: 600;
            border-radius: 6px 6px 0 0;
        }

        .table-custom td {
            background: #fff;
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
        }

        .table-custom tr:hover td {
            background-color: #f5f2ef;
            transition: .25s;
        }

    /* Action buttons */
    .btn-action {
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        margin-right: 5px;
        color: white !important;
        transition: 0.25s;
    }

    .btn-edit {
        background-color: #f0ad4e;
    }

        .btn-edit:hover {
            background-color: #ec9a35;
        }

    .btn-info2 {
        background-color: #0275d8;
    }

        .btn-info2:hover {
            background-color: #025aa5;
        }

    .btn-delete {
        background-color: #d9534f;
    }

        .btn-delete:hover {
            background-color: #c9302c;
        }
</style>
