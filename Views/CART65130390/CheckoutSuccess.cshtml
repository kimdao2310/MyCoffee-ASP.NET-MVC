@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Thanh toán thành công";
}

<div class="success-box">
    <img src="~/Images/success.png" class="success-img" />

    <h2>🎉 Đặt hàng thành công!</h2>
    <p>Cảm ơn bạn đã mua hàng tại MY COFFEE.</p>
    <p>Nhân viên sẽ xử lý đơn hàng của bạn trong thời gian sớm nhất.</p>

    <a href="@Url.Action("Index", "Home")" class="btn-home">⬅ Quay về trang chủ</a>
</div>

<style>
    .success-box {
        text-align: center;
        padding: 40px;
        background: #fff;
        border-radius: 15px;
        max-width: 600px;
        margin: 40px auto;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        border-left: 6px solid #8B5E34;
    }

    .success-img {
        width: 140px;
        margin-bottom: 20px;
    }

    h2 {
        color: #8B5E34;
        font-weight: 700;
    }

    p {
        font-size: 1.1rem;
        margin-top: 8px;
        color: #555;
    }

    .btn-home {
        display: inline-block;
        margin-top: 25px;
        padding: 12px 25px;
        background: #8B5E34;
        color: white;
        border-radius: 10px;
        text-decoration: none;
        font-weight: bold;
        transition: 0.25s;
    }

        .btn-home:hover {
            background: #704A29;
            transform: translateY(-2px);
        }
</style>
